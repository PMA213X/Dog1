            baseColor 0.2 0.2 0.2
            roughness 0.8
          }
          Box {
            size 0.03 0.124 0.03
          }
        ]
        name "hr_abd_link"
        physics Physics {
          mass 0.54
          centerOfMass 0 -0.026 0
          inertiaMatrix [
