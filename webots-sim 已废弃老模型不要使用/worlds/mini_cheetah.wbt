            5.8e-05, 5.60e-04, 9.5e-07,
            4.5e-07, 9.5e-07, 4.44e-04
          ]
          density -1
        }
        HingeJoint {
          jointParameters HingeJointParameters {
            anchor 0 0 0
            axis 0 -1 0
            dampingConstant 1.0
            stopSpringDamper 100 1
          }
          device [
            RotationalMotor {
              name "hr_hip_motor"
              maxTorque 20.0
            }
            PositionSensor {
              name "hr_hip_sensor"
            }
          ]
          child Solid {
            translation 0 0 -0.1045
            children [
              PBRAppearance {
                baseColor 0.25 0.25 0.25
                roughness 0.7
              }
              Box {
                size 0.04 0.04 0.209
              }
            ]
            name "hr_thigh_link"
            physics Physics {
              mass 0.634
              centerOfMass 0 0.016 -0.02
              inertiaMatrix [
                1.983e-03, 2.45e-04, 1.3e-05,
                2.45e-04, 2.103e-03, 1.5e-06,
                1.3e-05, 1.5e-06, 4.08e-04
              ]
              density -1
            }
            HingeJoint {
              jointParameters HingeJointParameters {
                anchor 0 0 -0.1045
                axis 0 -1 0
                dampingConstant 1.0
                stopSpringDamper 100 1
              }
              device [
                RotationalMotor {
                  name "hr_kn_motor"
                  maxTorque 20.0
                }
                PositionSensor {
                  name "hr_kn_sensor"
                }
              ]
              child Solid {
                translation 0 0 -0.09
                children [
                  PBRAppearance {
                    baseColor 0.3 0.3 0.3
                    roughness 0.6
                  }
                  Box {
                    size 0.03 0.03 0.18
                  }
                  PBRAppearance {
                    baseColor 0.1 0.1 0.1
                    roughness 0.9
                  }
                  Sphere {
                    radius 0.015
                    subdivision 4
                  }
                ]
                name "hr_shank_link"
                physics Physics {
                  mass 0.214
                  centerOfMass 0 0 0
                  inertiaMatrix [
                    2.70e-04, 0, 0,
                    0, 2.73e-04, 0,
                    0, 0, 3.1e-05
                  ]
                  density -1
                }
                contactMaterial "hr_toe"
              }
            }
          }
        }
      }
    }

    # ---- Hind Left Leg ----
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor -0.19 0.049 0
        axis 1 0 0
        dampingConstant 1.0
        stopSpringDamper 100 1
      }
      device [
        RotationalMotor {
          name "hl_abd_motor"
