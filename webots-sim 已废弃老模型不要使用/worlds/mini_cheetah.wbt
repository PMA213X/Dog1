              }
            ]
            name "hl_thigh_link"
            physics Physics {
              mass 0.634
              centerOfMass 0 -0.016 -0.02
              inertiaMatrix [
                1.983e-03, 2.45e-04, 1.3e-05,
                2.45e-04, 2.103e-03, 1.5e-06,
                1.3e-05, 1.5e-06, 4.08e-04
              ]
              density -1
            }
            HingeJoint {
              jointParameters HingeJointParameters {
                anchor 0 0 -0.1045
                axis 0 -1 0
                dampingConstant 1.0
                stopSpringDamper 100 1
              }
              device [
                RotationalMotor {
                  name "hl_kn_motor"
                  maxTorque 20.0
                }
                PositionSensor {
                  name "hl_kn_sensor"
                }
              ]
              child Solid {
                translation 0 0 -0.09
                children [
                  PBRAppearance {
                    baseColor 0.3 0.3 0.3
                    roughness 0.6
                  }
                  Box {
                    size 0.03 0.03 0.18
                  }
                  PBRAppearance {
                    baseColor 0.1 0.1 0.1
