            roughness 0.8
          }
          Box {
            size 0.03 0.124 0.03
          }
        ]
        name "hl_abd_link"
        physics Physics {
          mass 0.54
          centerOfMass 0 0.026 0
          inertiaMatrix [
            3.81e-04, 5.8e-05, 4.5e-07,
            5.8e-05, 5.60e-04, 9.5e-07,
            4.5e-07, 9.5e-07, 4.44e-04
          ]
          density -1
        }
        HingeJoint {
          jointParameters HingeJointParameters {
            anchor 0 0 0
            axis 0 -1 0
