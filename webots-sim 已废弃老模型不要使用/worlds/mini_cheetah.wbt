  physics Physics {
    mass 3.3
    centerOfMass 0 0 0
    inertiaMatrix [
      0.011253, 0, 0,
      0, 0.036203, 0,
      0, 0, 0.042673
    ]
    density -1
    frictionMaterial ContactProperties {
      coulombFriction [
        0.8
      ]
      bounceVelocity 0.01
    }
  }
  controller "mini_cheetah_controller"
  controllerArgs []
  selfCollision TRUE
