        HingeJoint {
          jointParameters HingeJointParameters {
            anchor 0 0 0
            axis 0 -1 0
            dampingConstant 1.0
            stopSpringDamper 100 1
          }
          device [
            RotationalMotor {
              name "fl_hip_motor"
              maxTorque 20.0
            }
