            -10 1 0.0502 10 1 0.0502
            -10 2 0.0502 10 2 0.0502
            -10 3 0.0502 10 3 0.0502
            -10 4 0.0502 10 4 0.0502
            -10 5 0.0502 10 5 0.0502
            -10 6 0.0502 10 6 0.0502
            -10 7 0.0502 10 7 0.0502
            -10 8 0.0502 10 8 0.0502
            -10 9 0.0502 10 9 0.0502
            -10 10 0.0502 10 10 0.0502
            -10 -10 0.0502 -10 10 0.0502
            -9 -10 0.0502 -9 10 0.0502
            -8 -10 0.0502 -8 10 0.0502
            -7 -10 0.0502 -7 10 0.0502
            -6 -10 0.0502 -6 10 0.0502
            -5 -10 0.0502 -5 10 0.0502
            -4 -10 0.0502 -4 10 0.0502
            -3 -10 0.0502 -3 10 0.0502
            -2 -10 0.0502 -2 10 0.0502
            -1 -10 0.0502 -1 10 0.0502
            0 -10 0.0502 0 10 0.0502
            1 -10 0.0502 1 10 0.0502
            2 -10 0.0502 2 10 0.0502
            3 -10 0.0502 3 10 0.0502
            4 -10 0.0502 4 10 0.0502
            5 -10 0.0502 5 10 0.0502
            6 -10 0.0502 6 10 0.0502
            7 -10 0.0502 7 10 0.0502
            8 -10 0.0502 8 10 0.0502
            9 -10 0.0502 9 10 0.0502
            10 -10 0.0502 10 10 0.0502
          ]
        }
        coordIndex [
          0, 1, -1, 2, 3, -1, 4, 5, -1,
          6, 7, -1, 8, 9, -1, 10, 11, -1,
          12, 13, -1, 14, 15, -1, 16, 17, -1,
          18, 19, -1, 20, 21, -1, 22, 23, -1,
          24, 25, -1, 26, 27, -1, 28, 29, -1,
          30, 31, -1, 32, 33, -1, 34, 35, -1,
          36, 37, -1, 38, 39, -1, 40, 41, -1,
          42, 43, -1, 44, 45, -1, 46, 47, -1,
          48, 49, -1, 50, 51, -1, 52, 53, -1,
          54, 55, -1, 56, 57, -1, 58, 59, -1,
          60, 61, -1, 62, 63, -1, 64, 65, -1,
          66, 67, -1, 68, 69, -1, 70, 71, -1,
          72, 73, -1, 74, 75, -1, 76, 77, -1,
          78, 79, -1, 80, 81, -1, 82, 83, -1
        ]
      }
    }
  ]
  boundingObject Box {
    size 20 20 0.1
  }
}

DEF MINI_CHEETAH Robot {
  translation 0 0 0.45
  rotation 0 0 1 0
  name "mini_cheetah"
  supervisor TRUE
  children [
    # ---- IMU sensors on body ----
    InertialUnit {
      name "inertial unit"
      # R2025a 无 coordinateSystem 字段；本验收不依赖 IMU 坐标系。
    }
    Gyro {
      name "gyro"
    }
    Accelerometer {
      name "accelerometer"
    }

    # ---- Body visual ----
    Pose {
      translation 0 0 0
      rotation 0 0 1 0
      children [
        Shape {
          castShadows FALSE
          appearance Appearance {
            material Material {
              diffuseColor 0.8 0.8 0.8
            }
          }
          geometry Mesh {
            url [
              "../assets/meshes/mini_body.dae"
            ]
          }
        }
      ]
    }
# ---- Front Right Leg ----
    # Abduction joint (hip roll) - rotates around X axis
    HingeJoint {
      jointParameters HingeJointParameters {
        position 0
        anchor 0.19 -0.049 0
        axis 1 0 0
        dampingConstant 1.0
        springConstant 0
      }
      device [
        RotationalMotor {
          name "fr_abd_motor"
          maxTorque 20.0
        }
        PositionSensor {
          name "fr_abd_sensor"
        }
      ]
      endPoint Solid {
        translation 0.19 -0.111 0  # R2025a：相对父 Pose，保留官方零位几何
        children [
          Pose {
            translation -0.055 0.062 0
            rotation 0.707105482511 0.707108079859 2.31079311799e-07 3.14159219143
            children [
              Shape {
                castShadows FALSE
                appearance Appearance {
                  material Material {
                    diffuseColor 0.8 0.8 0.8
                  }
                }
                geometry Mesh {
                  url [
                    "../assets/meshes/mini_abad.dae"
                  ]
                }
              }
            ]
          }
        
        HingeJoint {
          jointParameters HingeJointParameters {
            position 0
            anchor 0 0 0
            axis 0 -1 0
            dampingConstant 1.0
            springConstant 0
          }
          device [
            RotationalMotor {
              name "fr_hip_motor"
              maxTorque 20.0
            }
            PositionSensor {
              name "fr_hip_sensor"
            }
          ]
          endPoint Solid {
            translation 0 0 -0.1045  # R2025a：相对父 Pose，保留官方零位几何
            children [
              Pose {
                translation 0 0 0.1045
                rotation 0 -1 0 1.5708
                children [
                  Shape {
                    castShadows FALSE
                    appearance Appearance {
                      material Material {
                        diffuseColor 0.8 0.8 0.8
                      }
                    }
                    geometry Mesh {
                      url [
                        "../assets/meshes/mini_upper_link.dae"
                      ]
                    }
                  }
                ]
              }
            
            HingeJoint {
              jointParameters HingeJointParameters {
                position 0
                anchor 0 0 -0.1045
                axis 0 -1 0
                dampingConstant 1.0
                springConstant 0
              }
              device [
                RotationalMotor {
                  name "fr_kn_motor"
                  maxTorque 20.0
                }
                PositionSensor {
                  name "fr_kn_sensor"
                }
              ]
              endPoint Solid {
                translation 0 0 -0.1945  # R2025a：相对父 Pose，保留官方零位几何
                children [
                  Pose {
                    translation 0 0 0.09
                    rotation 0 1 0 3.141592
                    children [
                      Shape {
                        castShadows FALSE
                        appearance Appearance {
                          material Material {
                            diffuseColor 0.8 0.8 0.8
                          }
                        }
                        geometry Mesh {
                          url [
                            "../assets/meshes/mini_lower_link.dae"
                          ]
                        }
                      }
                    ]
                  }
                  Pose {
                    translation 0 0 -0.09
                    rotation 0 0 1 0
                    children [
                      Shape {
                        appearance Appearance {
                          material Material {
                            diffuseColor 0.2 0.2 0.2
                          }
                        }
                        geometry Sphere {
                          radius 0.015
                          subdivision 4
                        }
                      }
                    ]
                  }
                ]
                name "fr_shank_link"
                boundingObject Group {
                  children [
                    Box { size 0.03 0.03 0.18 }
                  Transform {
                    translation 0 0 -0.09
                    children [
                      Sphere { radius 0.015 }
                    ]
                  }
                  ]
                }
                physics Physics {
                  mass 0.214
                  centerOfMass 0 0 0
                  inertiaMatrix [
      0.00027 0.000273 3.1e-05
      0 0 0
    ]
                  density -1
                }
                contactMaterial "default"
              }
            }
]
            name "fr_thigh_link"
            boundingObject Group {
              children [
                Box { size 0.04 0.04 0.209 }
              ]
            }
            physics Physics {
              mass 0.634
              centerOfMass 0 0.016 -0.02
              inertiaMatrix [
      0.001983 0.002103 0.000408
      0.000245 1.3e-05 1.5e-06
    ]
              density -1
            }
            # Knee joint (knee pitch) - rotates around -Y axis

          }
        }
]
        name "fr_abd_link"
        boundingObject Group {
          children [
            Box { size 0.03 0.124 0.03 }
          ]
        }
        physics Physics {
          mass 0.54
          centerOfMass 0 -0.026 0
          inertiaMatrix [
      0.000381 0.00056 0.000444
      5.8e-05 4.5e-07 9.5e-07
    ]
          density -1
        }
        # Hip joint (hip pitch) - rotates around -Y axis

      }
    }

