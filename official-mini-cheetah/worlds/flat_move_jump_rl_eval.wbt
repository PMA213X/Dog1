#VRML_SIM R2025a utf8
# 官方 Mini Cheetah 平地移动与跳跃 RL 训练世界
# 以屈膝时间线测试 world 为模板；出生高度0.45，为屈膝目标保留初始间隙。

WorldInfo {
  info [
    "Official Mini Cheetah flat move jump RL single-robot evaluation"
  ]
  title "Official Mini Cheetah Flat Move Jump RL Evaluation"
  basicTimeStep 4
  FPS 60
  optimalThreadCount 1
  contactProperties [
    ContactProperties {
      material1 "fr_toe"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0
      bounceVelocity 0
      forceDependentSlip [ 0 ]
      softERP 0.3
      softCFM 0.001
      maxContactJoints 20
    }
    ContactProperties {
      material1 "fl_toe"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0
      bounceVelocity 0
      forceDependentSlip [ 0 ]
      softERP 0.3
      softCFM 0.001
      maxContactJoints 20
    }
    ContactProperties {
      material1 "hr_toe"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0
      bounceVelocity 0
      forceDependentSlip [ 0 ]
      softERP 0.3
      softCFM 0.001
      maxContactJoints 20
    }
    ContactProperties {
      material1 "hl_toe"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0
      bounceVelocity 0
      forceDependentSlip [ 0 ]
      softERP 0.3
      softCFM 0.001
      maxContactJoints 20
    }
    ContactProperties {
      material1 "body"
      material2 "default"
      coulombFriction [ 0.8 ]
      bounce 0
      bounceVelocity 0.01
      softERP 0.3
      softCFM 0.001
    }
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.8 ]
      bounce 0
      bounceVelocity 0
      softERP 0.3
      softCFM 0.001
    }
  ]
}

DEF TELEOP_VIEW Viewpoint {
  orientation 0 0.573462344363 0.819231920519 2.45851136058
  position 3 -2 1.6
  follow ""
  followType "None"
  followSmoothness 2
}

Background {
  skyColor [0.7 0.8 1]
}

DirectionalLight {
  direction -0.4 0.2 -0.9
  intensity 0.8
  color 1 1 1
  castShadows TRUE
  on TRUE
}

# 静态平地上表面严格位于 z=0；物理碰撞仍完全由下方 Box 提供。
DEF FLAT_FLOOR Solid {
  name "floor"
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.22 0.32 0.38
        roughness 0.9
        metalness 0
      }
      geometry Box {
        size 20 20 0.1
      }
    }
    # 纯视觉的 1 m 彩色网格；不进入 boundingObject，也不参与接触或摩擦。
    Shape {
      castShadows FALSE
      appearance Appearance {
        material Material {
          diffuseColor 0.1 0.78 0.95
          emissiveColor 0.02 0.22 0.3
        }
      }
      geometry IndexedLineSet {
        coord Coordinate {
          point [
            -10 -10 0.0502 10 -10 0.0502
            -10 -9 0.0502 10 -9 0.0502
            -10 -8 0.0502 10 -8 0.0502
