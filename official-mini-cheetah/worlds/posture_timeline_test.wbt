            }
            physics Physics {
              mass 0.634
              centerOfMass 0 0.016 -0.02
              inertiaMatrix [
      0.001983 0.002103 0.000408
      0.000245 1.3e-05 1.5e-06
    ]
              density -1
            }
            # Knee joint (knee pitch) - rotates around -Y axis

