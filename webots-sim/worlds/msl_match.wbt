#VRML_SIM R2025a utf8
# MSL Match Field — 2026 RoboCup Middle Size League
# Field 22 m x 14 m, goals 2.44 x 2.0 m, FIFA size-5 ball
# Coordinate system: X=forward, Y=left, Z=up
# PROTOs live in ../protos (MslField / MslGoal / MslBall / MslEnvironment)

EXTERNPROTO "../protos/MslField.proto"
EXTERNPROTO "../protos/MslGoal.proto"
EXTERNPROTO "../protos/MslBall.proto"
EXTERNPROTO "../protos/MslEnvironment.proto"

WorldInfo {
  info [
    "MSL match field scene (2026 RoboCup rules)"
    "Field 22x14 m, goals 2.44x2.0 m, FIFA size-5 ball"
    "Controller: 行走 + 橙色球检测 (ball_detector)"
  ]
  title "MSL Match Field"
  basicTimeStep 4
  FPS 60
}
# ==== 观察视角（GUI: 视图 → 视角 切换）====
# 1) 第三人称·全景：看清整块 22×14 球场与机器人
Viewpoint {
  orientation -0.15 0.25 0 1.05
  position 14 -12 11
  follow "OFF"
  followType "Mounted Shot"
}
# 2) 第三人称·跟随机器人：镜头随机器人走，便于观察步态
Viewpoint {
  position 3 -3 1.2
  follow "ON"
  followType "Mounted Shot"
  followSmoothness 2
}
# 3) 第三人称·球门区：看 +X 球门与罚球区
Viewpoint {
  orientation -0.2 0.1 0 1.3
  position 16 -6 4
  follow "OFF"
}
# 4) 第三人称·俯视全景：战术视角（正上方略偏）
Viewpoint {
  orientation -0.1 0 0 0.4
  position 0 -1 24
  follow "OFF"
}
# 5) 机器人自己相机的等效视角（贴地低角度看球）
Viewpoint {
  orientation -0.4 1 0 0.3
  position 3.6 -0.8 0.5
  follow "OFF"
}
Background {
  skyColor [0.65 0.75 0.9]
}

# ---- Lighting ----
DirectionalLight {
  direction -0.4 0.2 -0.9
  intensity 0.8
  color 1 1 1
  castShadows TRUE
  on TRUE
}
DirectionalLight {
  direction 0.35 -0.15 -0.85
  intensity 0.3
  color 0.95 0.95 1
  castShadows FALSE
  on TRUE
}

# ---- Field carpet + all white markings ----
MslField {
  translation 0 0 0
}

# ---- Goals: +X end (opening toward -X), -X end rotated 180 deg ----
MslGoal {
  translation 11 0 0
  name "goal_x_pos"
}
MslGoal {
  translation -11 0 0
  rotation 0 0 1 3.14159265
  name "goal_x_neg"
}

# ---- FIFA size-5 ball at center spot ----
MslBall {
  translation 0 0 0.11
  name "msl_ball"
}

Robot {
  translation 3 0 0.26
  rotation 0 0 1 3.14159265
  name "yobogo_10s"
  children [
    # ---- 机体上的 IMU 传感器 ----
    InertialUnit {
      name "inertial unit"
    }
    Gyro {
      name "gyro"
    }
    Accelerometer {
      name "accelerometer"
    }
  # ==== 相机可调参数 (Camera tunable) ====
  # fov_rad: 水平FOV（弧度）。0.96~1.22 对应 55°~70°，推荐 1.05 (60°)
  # pitch_rad: 俯仰角（弧度，负值=低头）。-0.52~-0.70 对应 -30°~-40°，推荐 -0.61 (-35°)
  # 注：Webots R2025a 字段名是 fieldOfView（不是 fov）— 见 Camera.wrl
  # Webots Camera 光轴 = 相机局部 +X（实测验证：原点朝 +X 时画面中心为 +X 处色标）。
  # 俯仰低头 pitch_rad 弧度 => 父 Transform 绕 +Y 轴右手旋转 -pitch_rad。
  # 当前: fov=1.05 (60.2°), pitch=-0.44 (-25.2°)
  Transform {
    translation 0.2 0 0.055
    # pitch 由父 Transform 的 rotation 实现（绕 +Y，低头为正角）
    rotation 0 1 0 0.44
    # 备选（错误用法，仅记录）：rotation 1 0 0 -0.44
    #   —— 绕前向 X 轴是横滚(roll)，不是俯仰；勿用
    children [
      Camera {
        name "front_camera"
        width 640
        height 480
        fieldOfView 1.05
        # pitch 由父 Transform 的 rotation 实现，见上
        noise 0
        motionBlur 0
      }
    ]
  }
    # ---- 机体视觉件（L x W x H = 0.40 x 0.13 x 0.10）[合同] ----
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.15 0.15
        roughness 0.8
        metalness 0.1
      }
      geometry Box {
        size 0.4 0.13 0.1
      }
    }
    # ---- FR 腿（原点在关节处）----
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0.18 -0.052 0
        axis 1 0 0
        dampingConstant 1.0
      }
      device [
        RotationalMotor {
          name "fr_abd_motor"
          maxTorque 18
        }
        PositionSensor {
          name "fr_abd_sensor"
        }
      ]
      endPoint Solid {
        translation 0.18 -0.052 0   # 必须与 joint anchor 一致
        children [
          Transform {
            translation 0 -0.0325 0
            children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.2 0.2 0.2
                roughness 0.8
                metalness 0.1
              }
              geometry Box {
                size 0.04 0.065 0.04
              }
            }
            ]
          }
            HingeJoint {
              jointParameters HingeJointParameters {
                anchor 0 -0.065 0
                axis 0 -1 0
                dampingConstant 1.0
              }
              device [
                RotationalMotor {
                  name "fr_hip_motor"
                  maxTorque 18
                }
                PositionSensor {
                  name "fr_hip_sensor"
                }
              ]
              endPoint Solid {
                translation 0 -0.065 0   # 必须与 joint anchor 一致
                children [
                  Transform {
                    translation 0 0 -0.07
                    children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.2 0.2 0.2
                        roughness 0.8
                        metalness 0.1
                      }
                      geometry Box {
                        size 0.05 0.05 0.14
                      }
                    }
                    ]
                  }
                    HingeJoint {
                      jointParameters HingeJointParameters {
                        anchor 0 0 -0.14
                        axis 0 -1 0
                        dampingConstant 1.0
                      }
                      device [
                        RotationalMotor {
                          name "fr_kn_motor"
                          maxTorque 18
                        }
                        PositionSensor {
                          name "fr_kn_sensor"
                        }
                      ]
                      endPoint Solid {
                        translation 0 0 -0.14   # 必须与 joint anchor 一致
                        children [
                          Transform {
                            translation 0 0 -0.06
                            children [
                            Shape {
                              appearance PBRAppearance {
                                baseColor 0.2 0.2 0.2
                                roughness 0.8
                                metalness 0.1
                              }
                              geometry Box {
                                size 0.04 0.04 0.12
                              }
                            }
                            ]
                          }
                          Transform {
                            translation 0 0 -0.12
                            children [
                            Shape {
                              appearance PBRAppearance {
                                baseColor 0.1 0.1 0.1
                                roughness 0.8
                                metalness 0.1
                              }
                              geometry Sphere {
                                radius 0.02
                              }
                            }
                            ]
                          }
                        ]
                        name "fr_shank_link"
                        boundingObject Transform {
                          translation 0 0 -0.06
                          children [
                            Box { size 0.04 0.04 0.12 }
                          ]
                        }
                        physics Physics {
                          mass 0.254
                          centerOfMass 0 0 -0.06
                          inertiaMatrix [
                            0.001 0.001 0.0002
                            0 0 0
                          ]
                          density -1
                          damping Damping {
                            linear 0.5
                            angular 0.5
                          }
                        }
                      }
                    }
                ]
                name "fr_thigh_link"
                boundingObject Transform {
                  translation 0 0 -0.07
                  children [
                    Box { size 0.05 0.05 0.14 }
                  ]
                }
                physics Physics {
                  mass 0.75
                  centerOfMass 0 0.01 -0.07
                  inertiaMatrix [
                    0.003 0.0032 0.0006
                    0 0 0
                  ]
                  density -1
                  damping Damping {
                    linear 0.5
                    angular 0.5
                  }
                }
              }
            }
        ]
        name "fr_abd_link"
        boundingObject Transform {
          translation 0 -0.0325 0
          children [
            Box { size 0.04 0.065 0.04 }
          ]
        }
        physics Physics {
          mass 0.64
          centerOfMass 0 -0.03 0
          inertiaMatrix [
            0.001 0.0012 0.001
            0 0 0
          ]
          density -1
          damping Damping {
            linear 0.5
            angular 0.5
          }
        }
      }
    }
    # ---- FL 腿（原点在关节处）----
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0.18 0.052 0
        axis 1 0 0
        dampingConstant 1.0
