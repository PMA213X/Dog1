                                roughness 0.8
                                metalness 0.1
                              }
                              geometry Sphere {
                                radius 0.02
                              }
                            }
                            ]
                          }
                        ]
                        name "fl_shank_link"
                        boundingObject Transform {
                          translation 0 0 -0.06
                          children [
                            Box { size 0.04 0.04 0.12 }
                          ]
                        }
                        physics Physics {
                          mass 0.254
                          centerOfMass 0 0 -0.06
                          inertiaMatrix [
                            0.001 0.001 0.0002
                            0 0 0
                          ]
                          density -1
                          damping Damping {
                            linear 0.5
                            angular 0.5
                          }
                        }
                      }
                    }
                ]
                name "fl_thigh_link"
                boundingObject Transform {
                  translation 0 0 -0.07
                  children [
                    Box { size 0.05 0.05 0.14 }
                  ]
                }
                physics Physics {
                  mass 0.75
                  centerOfMass 0 -0.01 -0.07
                  inertiaMatrix [
                    0.003 0.0032 0.0006
                    0 0 0
                  ]
                  density -1
                  damping Damping {
                    linear 0.5
                    angular 0.5
                  }
                }
              }
            }
        ]
        name "fl_abd_link"
        boundingObject Transform {
          translation 0 0.0325 0
          children [
            Box { size 0.04 0.065 0.04 }
          ]
        }
        physics Physics {
          mass 0.64
          centerOfMass 0 0.03 0
          inertiaMatrix [
            0.001 0.0012 0.001
            0 0 0
          ]
          density -1
