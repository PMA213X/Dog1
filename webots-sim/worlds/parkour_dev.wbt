    # ---- HL 腿（原点在关节处）----
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor -0.18 0.052 0
        axis 1 0 0
        dampingConstant 1.0
      }
      device [
        RotationalMotor {
          name "hl_abd_motor"
          maxTorque 18
        }
