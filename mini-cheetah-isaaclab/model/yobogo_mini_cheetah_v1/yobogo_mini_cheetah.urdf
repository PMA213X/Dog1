YoboGo-10S 资产元数据（静态验收口径）
leg_mapping=leg0:FR,leg1:FL,leg2:RR,leg3:RL
joint_order=leg0_abad_joint,leg0_hip_joint,leg0_knee_joint,leg1_abad_joint,leg1_hip_joint,leg1_knee_joint,leg2_abad_joint,leg2_hip_joint,leg2_knee_joint,leg3_abad_joint,leg3_hip_joint,leg3_knee_joint
