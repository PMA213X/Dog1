sim_initial_joint_positions_flat=[0,-0.785398163,1.865468294,0,-0.785398163,1.865468294,0,-0.785398163,1.865468294,0,-0.785398163,1.865468294]
sim_initial_root_xyz=0,0,0.26
target_joint_semantics=YoboGo control-side logical coordinates; not direct MIT URDF geometric angles
sim_initial_joint_semantics=ORCAgym geometry stance for foot collision minimum -0.26 m relative root
foot_visual_collision_origin_xyz=0,0,0.024
control_period_s=0.002
control_frequency_hz=500
pd_kp=3,3,3
pd_kd=1,0.2,0.2
effort_limit=17,17,26
source_total_mass_kg=8.292
target_total_mass_kg=9
mass_scale=9/8.292=1.08538350217
dynamics_source=MIT ORCAgym commit 5aaff694ae5f1c31e08040d59787f2cca4c5cfe0
visual_source=local ../visual_dae four DAE only
control_source=YoboGo-control local files
softstop_source=MIT Cheetah-Software SpineBoard reference
limit_semantics=URDF limit is software/safety candidate, mechanical hard stop unknown
knee_limit_semantics=knee [-2.7,2.7] is local initial/safety candidate only
collision_status=MIT conservative candidates, CAD not split into links
source_foot_inertia=all four MIT source tensors are zero
foot_inertia_derivation=solid_sphere_i=2/5*m*r^2
foot_inertia_mass_kg=0.0108538350217
foot_inertia_radius_m=0.0202
foot_inertia_diagonal_kg_m2=1.7715195369e-06
foot_inertia_status=derived from trusted foot mass and MIT collision sphere radius for PhysX positive definiteness; not MIT original inertia; not a guessed epsilon
-->
